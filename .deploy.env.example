# Copy to .deploy.env (gitignored) on every machine that runs the deploy scripts.

# Your private Docker Hub repository, as namespace/repo
PLANKA_IMAGE_REPO=your-namespace/planka-custom

# Architecture the image is built for. EC2 is x86_64, so keep linux/amd64 even on an
# Apple Silicon Mac - the image then runs locally under emulation.
PLANKA_BUILD_PLATFORM=linux/amd64
